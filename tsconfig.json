{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Les tests (tests/*.test.ts) tournent sur le lanceur natif de Node, qui
    // exécute le TypeScript sans transpilation — et la résolution ESM de Node
    // EXIGE alors l'extension explicite : `from '../lib/tasks.ts'`. TypeScript
    // la refuse par défaut. Cette option l'autorise sans jamais l'imposer :
    // tout le code applicatif continue d'importer sans extension.
    // Elle demande `noEmit` (posé ci-dessus) — c'est déjà le cas, Next compile
    // avec SWC et tsc ne sert qu'à vérifier les types.
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // supabase/functions/* tourne sur Deno (imports https://, global `Deno`),
  // jamais sur Node/navigateur — ce n'est pas du code Next.js et ça n'a
  // jamais dû être type-checké par ce projet TS. Sans cette exclusion,
  // `tsc --noEmit` et `next build` échouaient systématiquement sur ce
  // fichier, indépendamment de tout changement applicatif réel.
  "exclude": ["node_modules", "supabase/functions"]
}
